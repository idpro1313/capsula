# ===========================================
# Capsula - Environment Configuration
# ===========================================

# -------- Telegram Bot --------
# Get from @BotFather: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL (required for production/Docker)
# Must be HTTPS for Telegram webhooks
# Example: https://yourdomain.com
WEBHOOK_URL=https://your-domain.com

# Webhook path (optional, default: /webhook)
WEBHOOK_PATH=/webhook

# Bot server port
BOT_PORT=3000

# -------- Database --------
POSTGRES_USER=capsula
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=capsula
POSTGRES_PORT=5432

# Database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://capsula:your_secure_password_here@db:5432/capsula

# -------- Application --------
NODE_ENV=production