{
  "name": "capsula",
  "version": "1.0.0",
  "private": true,
  "description": "Virtual pets collection game in Telegram with Gacha, care and evolution mechanics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev -w apps/bot",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -ws",
    "db:migrate": "npm run db:migrate -w apps/bot",
    "db:generate": "npm run db:generate -w apps/bot"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}