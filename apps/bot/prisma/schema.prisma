// Capsula - Virtual Pets Collection Game
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum PetType {
  STIRLING   // Star spirit
  FLAMIKIN   // Fire fox
  DROPLET    // Water cat
  GROWLY     // Forest bear
  SPARKLE    // Electric hedgehog
  LUNARIK    // Moon rabbit
}

enum ItemType {
  FOOD
  TOY
  BOOST
}

enum TradeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================
// USER
// ============================================

model User {
  id            String    @id @default(uuid())
  telegramId    BigInt    @unique
  username      String?
  firstName     String
  starsBalance  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  pets           Pet[]
  inventory      Inventory[]
  tradesAsSeller Trade[]    @relation("Seller")
  tradesAsBuyer  Trade[]    @relation("Buyer")
  dailyReward    DailyReward?

  @@map("users")
}

// ============================================
// PET
// ============================================

model Pet {
  id           String   @id @default(uuid())
  ownerId      String
  name         String
  type         PetType
  rarity       Rarity   @default(COMMON)
  generation   Int      @default(1)
  level        Int      @default(1)
  experience   Int      @default(0)

  // Stats
  hunger    Int @default(50)
  happiness Int @default(50)
  energy    Int @default(50)

  // Evolution chain
  evolvedFromId String?
  evolvedFrom   Pet?   @relation("EvolutionChain", fields: [evolvedFromId], references: [id])
  evolvedInto   Pet[]  @relation("EvolutionChain")

  // Trading
  isTradable Boolean  @default(true)
  tradableAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tradesAsPet  Trade[]

  @@map("pets")
}

// ============================================
// ITEM
// ============================================

model Item {
  id          String   @id @default(uuid())
  type        ItemType
  name        String
  description String?
  effect      Json     // { stat: "hunger|happiness|energy", value: number }
  imageUrl    String?
  priceStars  Int?     // null = not purchasable for stars
  createdAt   DateTime @default(now())

  // Relations
  inventory Inventory[]

  @@map("items")
}

// ============================================
// INVENTORY
// ============================================

model Inventory {
  id       String @id @default(uuid())
  userId   String
  itemId   String
  quantity Int    @default(1)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("inventory")
}

// ============================================
// TRADE
// ============================================

model Trade {
  id          String      @id @default(uuid())
  sellerId    String
  petId       String
  buyerId     String?
  status      TradeStatus @default(ACTIVE)
  priceStars  Int?        // null = gift, number = sale price
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  // Relations
  seller  User  @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer   User? @relation("Buyer", fields: [buyerId], references: [id])
  pet     Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("trades")
}

// ============================================
// DAILY REWARD
// ============================================

model DailyReward {
  id        String   @id @default(uuid())
  userId    String   @unique
  streak    Int      @default(0)
  lastClaim DateTime @default(now())
  reward    Json     // { type: "stars", value: number }

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_rewards")
}

// ============================================
// GAME SESSION (for mini-games)
// ============================================

model GameSession {
  id         String   @id @default(uuid())
  userId     String
  gameType   String   // "catch_star"
  score      Int
  rewards    Json     // { food: number }
  boostUsed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("game_sessions")
}

// ============================================
// INDEXES
// ============================================

// For leaderboard queries
@@index([experience])
@@index([level])

// For trade listings
@@index([status])
@@index([priceStars])

// For user stats updates
@@index([hunger])
@@index([happiness])
@@index([energy])